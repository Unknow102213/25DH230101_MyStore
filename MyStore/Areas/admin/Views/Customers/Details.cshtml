
@model MyStore.Models.Customer

@{
    ViewBag.Title = "Chi tiết khách hàng";
    Layout = "~/Areas/admin/Views/Shared/_AdminLayout.cshtml";
}

<h2>THÔNG TIN KHÁCH HÀNG</h2>

<dl class="dl-horizontal">
    <dt>Họ tên</dt>
    <dd>@Model.CustomerName</dd>

    <dt>Tên đăng nhập</dt>
    <dd>@Model.Username</dd>

    <dt>Số điện thoại</dt>
    <dd>@Model.CustomerPhone</dd>

    <dt>Email</dt>
    <dd>@Model.CustomerEmail</dd>

    <dt>Địa chỉ</dt>
    <dd>@Model.CustomerAddress</dd>
</dl>

<h3>Danh sách đơn hàng (@Model.Orders.Count)</h3>

@foreach (var order in Model.Orders.OrderByDescending(o => o.OrderDate))
{
    @Html.Partial("~/Views/Shared/_OrderInvoice.cshtml", order)
}

@Html.ActionLink("Quay lại", "Index", null, new { @class = "btn btn-default" })
