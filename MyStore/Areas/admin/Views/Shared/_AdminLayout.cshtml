<!DOCTYPE html>
<html lang="vi">
    <head>
        <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>@ViewBag.Title - QUẢN TRỊ MY STORE</title>
        @Styles.Render("~/Content/css")
        <style>
            body{
                padding-top:62px;
                background:#f5f6fa
            }
            .admin-nav{background:#202b3c!important}
            .admin-nav .dropdown-menu a{color:#222!important}
            .admin-main{background:#fff;border-radius:8px;padding:24px;margin-top:22px;min-height:70vh;box-shadow:0 2px 10px rgba(0,0,0,.05)}
            .admin-main h2{margin-top:0;margin-bottom:22px}
            .table img{max-width:70px;max-height:70px;object-fit:contain}
            .stat-card{padding:18px;background:#edf2f7;border-radius:8px;margin-bottom:15px}
            .admin-footer{padding:20px;text-align:center;color:#777}
        </style>
        @RenderSection("Styles", required: false)
    </head>
    <body>
        <nav class="navbar navbar-expand-xl navbar-dark bg-dark fixed-top admin-nav">
            <div class="container-fluid">
                <a class="navbar-brand" href="@Url.Action("Index","Home",new { area="admin" })">MY STORE | QUẢN TRỊ</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#adminMenu">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="adminMenu">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">@Html.ActionLink("Tổng quan", "Index", "Home", new { area = "admin" }, new { @class="nav-link" })</li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Quản lý danh mục</a>
                            <ul class="dropdown-menu">
                                <li>@Html.ActionLink("Danh mục sản phẩm", "Index", "Categories", new { area = "admin" }, new { @class="dropdown-item" })</li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Quản lý hàng hóa</a>
                            <ul class="dropdown-menu">
                                <li>@Html.ActionLink("Danh sách hàng hóa", "Index", "Products", new { area = "admin" }, new { @class="dropdown-item" })</li>
                                <li>@Html.ActionLink("Thêm hàng hóa", "Create", "Products", new { area = "admin" }, new { @class="dropdown-item" })</li>
                            </ul>
                        </li>
                        <li class="nav-item">@Html.ActionLink("Quản lý kho", "Index", "Inventory", new { area = "admin" }, new { @class="nav-link" })</li>
                        <li class="nav-item">@Html.ActionLink("Quản lý Admin", "Index", "Users", new { area = "admin" }, new { @class="nav-link" })</li>
                        <li class="nav-item">@Html.ActionLink("Khách hàng", "Index", "Customers", new { area = "admin" }, new { @class="nav-link" })</li>
                        <li class="nav-item">@Html.ActionLink("Đơn hàng", "Index", "Orders", new { area = "admin" }, new { @class="nav-link" })</li>
                    </ul>
                    <ul class="navbar-nav">
                        <li class="nav-item">@Html.ActionLink("Xem website", "Index", "Home", new { area = "" }, new { @class="nav-link" })</li>
                        <li class="nav-item">@Html.ActionLink("Đăng xuất", "Logout", "Account", new { area = "" }, new { @class="nav-link" })</li>
                    </ul>
                </div>
            </div>
        </nav>
        <div class="container-fluid admin-main">
            @if (TempData["Success"] != null) 
            { 
                <div class="alert alert-success">@TempData["Success"]</div> 
            } 
            @if (TempData["Error"] != null) 
            { 
                <div class="alert alert-danger">@TempData["Error"]</div> 
            } 
            @RenderBody()
        </div>
        <footer class="admin-footer">&copy; @DateTime.Now.Year - My Store Admin</footer>
        @Scripts.Render("~/bundles/jquery") 
        @Scripts.Render("~/bundles/bootstrap") 
        @Scripts.Render("~/bundles/jqueryval") 
        @RenderSection("scripts", required: false)
    </body>
</html>
