
@model MyStore.Models.Product

@{
    ViewBag.Title = "Chi tiết sản phẩm";
    Layout = "~/Areas/admin/Views/Shared/_AdminLayout.cshtml";
}

<h2>CHI TIẾT SẢN PHẨM</h2>

@Html.Partial("~/Views/Shared/_ProductDetail.cshtml", Model)

<p>
    @Html.ActionLink("Sửa sản phẩm", "Edit", new { id = Model.ProductID }, new { @class = "btn btn-primary" })
    @Html.ActionLink("Quay lại", "Index", null, new { @class = "btn btn-default" })
</p>
