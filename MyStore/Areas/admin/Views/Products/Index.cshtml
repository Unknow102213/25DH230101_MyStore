
@model MyStore.Models.ViewModel.ProductSearchVM

@{
    ViewBag.Title = "Quản lý sản phẩm";
    Layout = "~/Areas/admin/Views/Shared/_AdminLayout.cshtml";
}

<h2>QUẢN LÝ SẢN PHẨM</h2>

<p>
    @Html.ActionLink("Thêm sản phẩm", "Create", null, new { @class = "btn btn-primary" })    
</p>

@using (Html.BeginForm("Index", "Products", FormMethod.Get, new { @class = "form-inline" }))
{
    @Html.TextBox("SearchTerm", Model.SearchTerm, new { @class = "form-control", placeholder = "Tên, mô tả, danh mục" })
    @Html.TextBox("MinPrice", Model.MinPrice, new { @class = "form-control", placeholder = "Giá từ" })
    @Html.TextBox("MaxPrice", Model.MaxPrice, new { @class = "form-control", placeholder = "Giá đến" })

    <button class="btn btn-primary" type="submit">Tìm kiếm</button>
}

<p>
    Sắp xếp:
    @Html.ActionLink("Tên A-Z", "Index", new { SearchTerm = Model.SearchTerm, MinPrice = Model.MinPrice, MaxPrice = Model.MaxPrice, sortOrder = "name_asc" })
    |
    @Html.ActionLink("Tên Z-A", "Index", new { SearchTerm = Model.SearchTerm, MinPrice = Model.MinPrice, MaxPrice = Model.MaxPrice, sortOrder = "name_desc" })
    |
    @Html.ActionLink("Giá tăng", "Index", new { SearchTerm = Model.SearchTerm, MinPrice = Model.MinPrice, MaxPrice = Model.MaxPrice, sortOrder = "price_asc" })
    |
    @Html.ActionLink("Giá giảm", "Index", new { SearchTerm = Model.SearchTerm, MinPrice = Model.MinPrice, MaxPrice = Model.MaxPrice, sortOrder = "price_desc" })
</p>

@if (!Model.Products.Any())
{
    <div class="alert alert-info">Không có sản phẩm phù hợp.</div>
}

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Sản phẩm</th>
            <th>Ảnh</th>
            <th>Giá</th>
            <th>Tồn kho</th>
            <th>Danh mục</th>
            <th>Thao tác</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var p in Model.Products)
        {
            <tr>
                <td>@p.ProductName</td>
                <td>
                    <img src="@Url.Content(p.ProductImage ?? "~/Images/no-image.svg")" />
                </td>
                <td>@p.ProductPrice.ToString("N0") đ</td>
                <td>@p.Quantity</td>
                <td>@p.Category.CategoryName</td>
                <td>
                    @Html.ActionLink("Chi tiết", "Details", new { id = p.ProductID }, new { @class = "btn btn-info btn-xs" })
                    @Html.ActionLink("Sửa", "Edit", new { id = p.ProductID }, new { @class = "btn btn-primary btn-xs" })
                    @Html.ActionLink("Xóa", "Delete", new { id = p.ProductID }, new { @class = "btn btn-danger btn-xs" })
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="text-center">
    @Html.PagedListPager(Model.Products, page => Url.Action("Index", new { page, SearchTerm = Model.SearchTerm, MinPrice = Model.MinPrice, MaxPrice = Model.MaxPrice, sortOrder = Model.SortOrder }))
</div>
