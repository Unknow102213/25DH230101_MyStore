
@model MyStore.Models.ViewModel.CheckoutVM

@{
    ViewBag.Title = "Thanh toán";
}

<h2>THÔNG TIN THANH TOÁN</h2>

<div class="well">
    <p><strong>Khách hàng:</strong> @Model.CustomerName</p>
    <p><strong>Điện thoại:</strong> @Model.CustomerPhone</p>
    <p><strong>Email:</strong> @Model.CustomerEmail</p>
</div>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Sản phẩm</th>
            <th>Số lượng</th>
            <th>Đơn giá</th>
            <th>Thành tiền</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model.CartItems)
        {
            <tr>
                <td>@item.ProductName</td>
                <td>@item.Quantity</td>
                <td>@item.UnitPrice.ToString("N0") đ</td>
                <td>@item.TotalPrice.ToString("N0") đ</td>
            </tr>
        }
    </tbody>
</table>

@using (Html.BeginForm("Checkout", "Order", FormMethod.Post))
{
    @Html.AntiForgeryToken()

    @Html.HiddenFor(m => m.PaymentMethod, new { Value = "Tiền mặt" })

    <div class="form-horizontal">
        @Html.ValidationSummary(false, "", new { @class = "text-danger" })

        <div class="form-group">
            @Html.LabelFor(m => m.ShippingAddress, new { @class = "control-label col-md-2" })

            <div class="col-md-8">
                @Html.TextAreaFor(m => m.ShippingAddress, new
                {
                    @class = "form-control",
                    rows = 3
                })

                @Html.ValidationMessageFor(m => m.ShippingAddress, "", new
                {
                    @class = "text-danger"
                })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.ShippingMethod, new { @class = "control-label col-md-2" })

            <div class="col-md-8">
                @Html.DropDownListFor(
                         m => m.ShippingMethod,
                         new SelectList(new[]
                         {
                        "Giao hàng nhanh",
                        "Giao hàng tiết kiệm"
                         }),
                         "-- Chọn phương thức --",
                         new { @class = "form-control" }
                     )

                @Html.ValidationMessageFor(m => m.ShippingMethod, "", new
                {
                    @class = "text-danger"
                })
            </div>
        </div>

        <div class="form-group">
            <label class="control-label col-md-2">Phương thức thanh toán</label>

            <div class="col-md-8">
                <p class="form-control-static">
                    Thanh toán khi nhận hàng (COD)
                </p>
            </div>
        </div>

        <div class="form-group">
            <label class="control-label col-md-2">Tổng thanh toán</label>

            <div class="col-md-8">
                <h3>@Model.TotalAmount.ToString("N0") đ</h3>
            </div>
        </div>

        <div class="form-group">
            <div class="col-md-offset-2 col-md-8">
                <button type="submit" class="btn btn-success">
                    Xác nhận đặt hàng
                </button>

                @Html.ActionLink(
                         "Quay lại giỏ hàng",
                         "Index2",
                         "Cart",
                         null,
                         new { @class = "btn btn-default" }
                     )
            </div>
        </div>
    </div>
}
