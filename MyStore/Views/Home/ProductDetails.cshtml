@model MyStore.Models.ViewModel.ProductDetailsVM

@{
    ViewBag.Title = "Chi tiết sản phẩm";
}

@Html.Partial("~/Views/Shared/_ProductDetail.cshtml", Model.product)

@if (Model.product.Quantity > 0)
{
    using (Html.BeginForm("AddToCart", "Cart", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.Hidden("id", Model.product.ProductID)

        <div class="form-inline">
            <label for="quantity">Số lượng</label>

            <input id="quantity"
                   name="quantity"
                   type="number"
                   class="form-control"
                   min="1"
                   max="@Model.product.Quantity"
                   value="@Model.quantity" />

            <div class="mt-2">
                Tạm tính:
                <strong>@Model.estimatedValue.ToString("N0") đ</strong>

                <button type="submit"
                        formaction="@Url.Action("ProductDetails", "Home", new { id = Model.product.ProductID })"
                        formmethod="get"
                        class="btn btn-outline-primary ms-2">
                    Cập nhật
                </button>
            </div>

            <button type="submit" class="btn btn-primary mt-2">
                Thêm vào giỏ hàng
            </button>
        </div>
    }
}
else
{
    <div class="alert alert-warning">
        Sản phẩm hiện đã hết hàng.
    </div>
}