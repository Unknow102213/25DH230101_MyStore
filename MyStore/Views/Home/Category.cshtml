
@model MyStore.Models.ViewModel.ProductSearchVM

@{
    ViewBag.Title = Model.CategoryName;
}

<h2>Danh mục: @Model.CategoryName</h2>

@using (Html.BeginForm("Category", "Home", FormMethod.Get, new { @class = "form-inline" }))
{
    @Html.HiddenFor(m => m.CategoryID)
    @Html.TextBoxFor(m => m.SearchTerm, new { @class = "form-control", placeholder = "Tìm tên hoặc mô tả" })
    @Html.TextBoxFor(m => m.MinPrice, new { @class = "form-control", placeholder = "Giá từ", type = "number", min = "0" })
    @Html.TextBoxFor(m => m.MaxPrice, new { @class = "form-control", placeholder = "Giá đến", type = "number", min = "0" })

    <button class="btn btn-primary" type="submit">Lọc / Tìm kiếm</button>
}

<p>
    Sắp xếp:
    @Html.ActionLink("Tên A-Z", "Category", new { id = Model.CategoryID, searchTerm = Model.SearchTerm, minPrice = Model.MinPrice, maxPrice = Model.MaxPrice, sortOrder = "name_asc" })
    |
    @Html.ActionLink("Tên Z-A", "Category", new { id = Model.CategoryID, searchTerm = Model.SearchTerm, minPrice = Model.MinPrice, maxPrice = Model.MaxPrice, sortOrder = "name_desc" })
    |
    @Html.ActionLink("Giá tăng", "Category", new { id = Model.CategoryID, searchTerm = Model.SearchTerm, minPrice = Model.MinPrice, maxPrice = Model.MaxPrice, sortOrder = "price_asc" })
    |
    @Html.ActionLink("Giá giảm", "Category", new { id = Model.CategoryID, searchTerm = Model.SearchTerm, minPrice = Model.MinPrice, maxPrice = Model.MaxPrice, sortOrder = "price_desc" })
</p>

@if (!Model.Products.Any())
{
    <div class="alert alert-info">Không có sản phẩm phù hợp.</div>
}

<div class="row">
    @foreach (var p in Model.Products)
    {
        <div class="col-sm-6 col-md-3">
            <div class="thumbnail">
                <a href="@Url.Action("ProductDetails", "Home", new { id = p.ProductID })">
                    <img src="@Url.Content(p.ProductImage ?? "~/Images/no-image.svg")" style="height:160px;object-fit:contain" />
                </a>

                <div class="caption">
                    <h4>@p.ProductName</h4>
                    <p>@p.ProductPrice.ToString("N0") đ</p>

                    <a class="btn btn-default" href="@Url.Action("ProductDetails", "Home", new { id = p.ProductID })">Chi tiết</a>

                    @using (Html.BeginForm("AddToCart", "Cart", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        @Html.Hidden("id", p.ProductID)
                        @Html.Hidden("quantity", 1)

                        <button class="btn btn-primary btn-sm" type="submit">Thêm vào giỏ</button>
                    }
                </div>
            </div>
        </div>
    }
</div>

<div class="text-center">
    @Html.PagedListPager(Model.Products, page => Url.Action("Category", new { id = Model.CategoryID, searchTerm = Model.SearchTerm, minPrice = Model.MinPrice, maxPrice = Model.MaxPrice, sortOrder = Model.SortOrder, page }))
</div>
