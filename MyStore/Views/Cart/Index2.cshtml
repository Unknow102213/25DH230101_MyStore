
@model MyStore.Models.ViewModel.Cart

@{
    ViewBag.Title = "Giỏ hàng";
}

<h2>GIỎ HÀNG</h2>

@if (!Model.Items.Any())
{
    <div class="alert alert-info">Giỏ hàng đang trống.</div>

    <p>
        @Html.ActionLink("Tiếp tục mua hàng", "Index", "Home", null, new { @class = "btn btn-primary" })
    </p>
}
else
{
    foreach (var group in Model.GroupedItems)
    {
        <h3>@group.Key</h3>

        <div class="table-responsive">
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th>Ảnh</th>
                        <th>Sản phẩm</th>
                        <th>Đơn giá</th>
                        <th>Số lượng</th>
                        <th>Thành tiền</th>
                        <th></th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in group)
                    {
                        <tr>
                            <td>
                                <img src="@Url.Content(item.ProductImage ?? "~/Images/no-image.svg")" style="max-height:65px" />
                            </td>
                            <td>@item.ProductName</td>
                            <td>@item.UnitPrice.ToString("N0") đ</td>
                            <td>
                                @using (Html.BeginForm("UpdateQuantity", "Cart", FormMethod.Post))
                                {
                                    @Html.AntiForgeryToken()
                                    @Html.Hidden("id", item.ProductID)

                                    <input type="number" name="quantity" value="@item.Quantity" min="1" max="@item.StockQuantity" style="width:75px" />

                                    <button class="btn btn-default btn-sm" type="submit">Cập nhật</button>
                                }
                            </td>
                            <td>@item.TotalPrice.ToString("N0") đ</td>
                            <td>
                                @using (Html.BeginForm("RemoveFromCart", "Cart", FormMethod.Post))
                                {
                                    @Html.AntiForgeryToken()
                                    @Html.Hidden("id", item.ProductID)

                                    <button class="btn btn-danger btn-sm" type="submit">Xóa</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <div class="well text-right">
        <h3>
            Tổng tiền: <strong>@Model.TotalValue().ToString("N0") đ</strong>
        </h3>

        @using (Html.BeginForm("ClearCart", "Cart", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <button class="btn btn-default" type="submit">Xóa giỏ hàng</button>
        }

        @Html.ActionLink("Tiếp tục mua hàng", "Index", "Home", null, new { @class = "btn btn-default" })
        @Html.ActionLink("Thanh toán", "Checkout", "Order", null, new { @class = "btn btn-primary" })
    </div>
}
