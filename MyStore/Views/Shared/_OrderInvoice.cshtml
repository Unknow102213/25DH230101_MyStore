
@model MyStore.Models.Order

<div class="order-invoice border rounded p-3 mb-3">
    <h3>THÔNG TIN ĐƠN HÀNG #@Model.OrderID</h3>

    <div class="row">
        <div class="col-md-4">
            <dl class="row">
                <dt class="col-sm-6">Ngày đặt hàng</dt>
                <dd class="col-sm-6">@Model.OrderDate.ToString("dd/MM/yyyy")</dd>

                <dt class="col-sm-6">Tên khách hàng</dt>
                <dd class="col-sm-6">@(Model.Customer == null ? "" : Model.Customer.CustomerName)</dd>

                <dt class="col-sm-6">Tổng giá trị</dt>
                <dd class="col-sm-6">@Model.TotalAmount.ToString("N0") đ</dd>

                <dt class="col-sm-6">Phương thức thanh toán</dt>
                <dd class="col-sm-6">@Model.PaymentMethod</dd>

                <dt class="col-sm-6">Trạng thái thanh toán</dt>
                <dd class="col-sm-6">@Model.PaymentStatus</dd>

                <dt class="col-sm-6">Trạng thái đơn hàng</dt>
                <dd class="col-sm-6">@Model.OrderStatus</dd>

                <dt class="col-sm-6">Phương thức giao hàng</dt>
                <dd class="col-sm-6">@Model.ShippingMethod</dd>

                <dt class="col-sm-6">Địa chỉ giao hàng</dt>
                <dd class="col-sm-6">@Model.ShippingAddress</dd>

                @if (Model.Customer != null)
                {
                    <dt class="col-sm-6">Số điện thoại</dt>
                    <dd class="col-sm-6">@Model.Customer.CustomerPhone</dd>
                }
            </dl>
        </div>

        <div class="col-md-8">
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th colspan="2">Sản phẩm</th>
                            <th>Số lượng</th>
                            <th>Đơn giá</th>
                            <th>Thành tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.OrderDetails)
                        {
                            <tr>
                                <td style="width:90px">
                                    <img src="@Url.Content(item.Product.ProductImage ?? "~/Images/no-image.svg")" alt="@item.Product.ProductName" 
                                         style="max-width:75px;max-height:100px;object-fit:contain" />
                                </td>
                                <td>
                                    @Html.ActionLink(item.Product.ProductName, "ProductDetails", "Home", new { area = "", id = item.ProductID }, null)
                                </td>
                                <td>@item.Quantity</td>
                                <td>@item.UnitPrice.ToString("N0") đ</td>
                                <td>@item.TotalPrice.ToString("N0") đ</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
