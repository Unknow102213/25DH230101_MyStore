
@model MyStore.Models.ViewModel.HomeProductVM

@using PagedList.Mvc

<link rel="stylesheet" type="text/css" href="~/Content/myStyle/CustomerHome.css" />

@if (Model.NewProducts != null && Model.NewProducts.Any())
{
    <section class="container-fluid listProduct">
        <h2>Sản phẩm mới</h2>

        <div class="row">
            @foreach (var product in Model.NewProducts)
            {
                <div class="col-sm-6 col-md-3">
                    <div class="thumbnail">
                        <a href="@Url.Action("ProductDetails", "Home", new { id = product.ProductID })">
                            <img src="@Url.Content(product.ProductImage ?? "~/Images/no-image.svg")" style="height:150px;object-fit:contain" />
                        </a>

                        <div class="caption">
                            <p class="prodPrice">@product.ProductPrice.ToString("N0") đ</p>
                            <p class="prodName">@product.ProductName</p>
                            <p>Đã bán: @product.QuantitySold</p>

                            @using (Html.BeginForm("AddToCart", "Cart", FormMethod.Post))
                            {
                                @Html.AntiForgeryToken()
                                @Html.Hidden("id", product.ProductID)
                                @Html.Hidden("quantity", 1)

                                <button class="btn btn-primary btn-sm" type="submit">Thêm vào giỏ</button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>

    <div class="text-center">
        @Html.PagedListPager(Model.NewProducts, page => Url.Action("Index", new { page, searchTerm = Model.SearchTerm }))
    </div>
}
else
{
    <p>Không tìm được sản phẩm nào phù hợp.</p>
}
