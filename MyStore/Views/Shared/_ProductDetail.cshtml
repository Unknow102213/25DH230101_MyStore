
@model MyStore.Models.Product

<div class="row product-detail-shared">
    <div class="col-md-4 text-center">
        <img src="@(String.IsNullOrWhiteSpace(Model.ProductImage) ? Url.Content("~/Images/no-image.svg") : Url.Content(Model.ProductImage))" 
             alt="@Model.ProductName" style="max-width:100%;max-height:320px;object-fit:contain" />
    </div>

    <div class="col-md-8">
        <h2>@Model.ProductName</h2>

        <p>
            <strong>Danh mục:</strong> @Model.Category.CategoryName
        </p>

        <p>
            <strong>Giá:</strong> @Model.ProductPrice.ToString("N0") đ
        </p>

        <p>
            <strong>Số lượng tồn:</strong> @Model.Quantity
        </p>

        <p>
            <strong>Đã bán:</strong> @Model.QuantitySold
        </p>

        <hr />

        <h4>Mô tả sản phẩm</h4>
        <p style="white-space:pre-line">@Model.ProductDescription</p>
    </div>
</div>
